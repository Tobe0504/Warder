{
  "name": "@warder/web",
  "version": "0.1.0",
  "private": true,
  "description": "Warder dashboard and Backend-for-Frontend. The browser talks only to this.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-boundaries.mjs",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON 'lib/**/*.test.ts'",
    "verify": "npm run check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.3.1",
    "lucide-react": "^0.475.0",
    "motion": "^13.1.0",
    "next": "^15.1.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.6"
  },
  "overridesComment": "sharp and postcss are pinned above the versions Next 15 resolves. Both had high-severity advisories whose only npm-suggested fix was a major Next upgrade. Pinning the two transitive packages clears them without that risk. Remove these when Next ships a release that resolves them itself."
}
