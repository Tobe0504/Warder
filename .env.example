# Warder configuration.
#
# Copy to .env and fill in. Every value below is a placeholder: none of them is
# a real credential, and none of them should be used in a deployment.
#
# .env is git-ignored. Do not commit it, and do not put any of these values in a
# NEXT_PUBLIC_ variable: they are all server-side.

# ---------------------------------------------------------------------------
# Core API (Go)
# ---------------------------------------------------------------------------

WARDER_ENV=development

# The role the running application uses. It should not own the schema.
WARDER_DATABASE_URL=postgres://warder:warder-local-dev-only@127.0.0.1:5432/warder?sslmode=disable

# Optional: a separate, schema-owning role used only by `warder-api migrate`.
# Keeping migration privileges out of the runtime role means a compromised
# application process cannot alter the schema or drop the audit trigger.
# WARDER_MIGRATION_DATABASE_URL=postgres://warder_migrator:...@127.0.0.1:5432/warder

# The human-facing API. Only the BFF should be able to reach it.
WARDER_ADMIN_ADDR=127.0.0.1:8080

# The machine-facing API, on its own listener so it can live on a different
# network from the dashboard's backend.
WARDER_RUNTIME_ADDR=127.0.0.1:8081

# Key encryption keys, supplied out of band and never stored in the database.
#
# Generate one with:   go run ./cmd/warder-api keygen
#
# To rotate: add v2 alongside v1 and point WARDER_ACTIVE_KEY_VERSION at it.
# Existing ciphertext keeps decrypting under the version it was written with.
WARDER_KEYRING=v1:REPLACE_ME_WITH_A_GENERATED_32_BYTE_BASE64_KEY
WARDER_ACTIVE_KEY_VERSION=v1

# Proves to the core API that a request came from the BFF rather than from a
# browser that discovered the address. At least 32 characters.
#
# Generate one with:   openssl rand -base64 36
WARDER_SERVICE_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Lifetimes.
WARDER_SESSION_TTL=12h
WARDER_CLI_SESSION_TTL=168h
# Deliberately short: this credential exists for one process start.
WARDER_RUNTIME_SESSION_TTL=5m

# Only enable behind a proxy that sets X-Forwarded-For itself. Trusting it
# otherwise lets any caller forge the address recorded in the audit trail and
# choose their own rate-limit bucket.
WARDER_TRUST_PROXY_HEADERS=false

WARDER_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Dashboard and BFF (Next.js), web/.env.local
# ---------------------------------------------------------------------------

# One variable, carrying the service token, the core API address, and the
# deployment posture together so they cannot drift apart.
#
#   warder+insecure://  plain HTTP, local development only
#   warder://           TLS, required for /production
#
# Generate the whole configuration with:  go run ./cmd/warder-api init
#
# The token here must match WARDER_SERVICE_TOKEN above.
WARDER_URL=warder+insecure://REPLACE_ME_WITH_THE_SERVICE_TOKEN@127.0.0.1:8080/development

# In production it looks like this instead. The origin is required there, so
# that cross-site requests can be refused:
#
#   WARDER_URL=warder://<token>@warder-api.internal:8443/production?origin=https://vault.example.com

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Integration tests skip themselves unless this is set.
WARDER_TEST_DATABASE_URL=postgres://warder:warder-local-dev-only@127.0.0.1:5432/warder?sslmode=disable
